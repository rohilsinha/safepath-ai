{
  "expo": {
    "name": "SafePath AI",
    "slug": "safepath-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "@rnmapbox/maps",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow SafePath to use your location to calculate routes."
        }
      ]
    ],
    "scheme": "safepath",
    "android": {
      "package": "com.safepath.mobile"
    },
    "ios": {
      "bundleIdentifier": "com.safepath.mobile"
    }
  }
}
